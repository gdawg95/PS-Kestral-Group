# Data: never commit raw or intermediate data (see DECISIONS.md D-015)
data/raw/
data/interim/
data/clean/
*.xlsx
*.xls
*.csv
!reports/**/*.csv

# The reviewer export is the one exception: de-identified, audited before it is written,
# and committed on purpose so reviewers can open the finished dataset without Python
# (src/export.py). Deliverable #1 itself stays out of git.
!export/*.csv
!export/*.xlsx

# Secrets and environments
.env
.venv/
__pycache__/
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/

# Run logs from the laptop (read by Claude through the bridge; may echo data)
logs/
